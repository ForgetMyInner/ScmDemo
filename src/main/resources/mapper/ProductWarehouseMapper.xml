            <result column="stop" property="stop"/>
            <result column="enable" property="enable"/>
        </association>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
            id,
            product_show,
            enable,
            enter_person,
            enter_time,
            update_time,
            update_person,
            product_num,
            warehouse_id
